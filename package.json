{
  "name": "noniebirthday",
  "version": "1.0.0",
  "description": "Birthday surprise website with Vite + GSAP + Cloudinary",
  "main": "src/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/**/*.{js,css,html}",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "birthday",
    "website",
    "vite",
    "gsap",
    "cloudinary"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "cloudinary-core": "^2.14.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "gsap": "^3.13.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cloudinary": "^2.7.0"
  }
}
