# Environment Configuration for NonieBirthday
# Copy this file to .env for development

# Cloudinary Configuration
# Only needed during development for API uploads
# Production uses public cloud name only
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key-here

# Firebase Configuration (optional, for video uploads)
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-bucket-name

# Development Settings
VITE_DEV_MODE=true